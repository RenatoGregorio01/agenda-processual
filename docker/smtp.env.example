# Copie para smtp.env (não versionado) e preencha.
# Uso:
#   cp docker/smtp.env.example docker/smtp.env
#   # edite docker/smtp.env
#   docker compose --env-file docker/smtp.env \
#     -f docker/docker-compose.yml -f docker/compose.smtp.yml up -d api
#
# Remetentes por responsabilidade (domínio verificado no Resend/Brevo):
#   convite@… → só convites de usuário
#   alerta@…  → só alertas de prazo
# Receber nesses aliases: Cloudflare Email Routing → Gmail (grátis).
# Gmail SMTP NÃO permite From diferente da conta autenticada — use Resend.

# --- Resend (recomendado em produção) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_xxxxxxxx
SMTP_FROM=noreply@agendaprocessual.com.br
SMTP_FROM_NAME=Agenda Processual
SMTP_FROM_CONVITE=convite@agendaprocessual.com.br
SMTP_FROM_NAME_CONVITE=Agenda Processual — Convite
SMTP_FROM_ALERTA=alerta@agendaprocessual.com.br
SMTP_FROM_NAME_ALERTA=Agenda Processual — Alerta
SMTP_TLS=true
SMTP_SSL=false

# --- Gmail (só teste; From = mesma conta) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_FROM=seu@gmail.com
# SMTP_FROM_NAME=Agenda Processual
# SMTP_FROM_CONVITE=seu@gmail.com
# SMTP_FROM_ALERTA=seu@gmail.com
# SMTP_TLS=true
# SMTP_SSL=false

# APP_PUBLIC_URL deve ser a URL pública do front (convites/alertas usam esse link)
# No homelab: https://agendaprocessual.com.br
# APP_PUBLIC_URL=https://agendaprocessual.com.br
