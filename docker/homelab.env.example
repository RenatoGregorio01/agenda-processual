# Copie para docker/homelab.env (não versionado) e preencha.
#
#   cp docker/homelab.env.example docker/homelab.env

# URLs públicas (Cloudflare Tunnel + domínio)
APP_PUBLIC_URL=https://agendaprocessual.com.br
NEXT_PUBLIC_API_URL=https://api.agendaprocessual.com.br
CORS_ORIGINS=https://agendaprocessual.com.br

# Segurança
JWT_SECRET=troque-por-um-segredo-longo-aleatorio-32chars+
SEED_ADMIN_PASSWORD=troque-a-senha-do-admin

# Cloudflare Zero Trust → Networks → Tunnels → Install connector → token
# Um túnel com 2 Public Hostnames (apex → web:3000, api → api:8000).
TUNNEL_TOKEN=

# Porta do banco exposta no host para acesso direto via DBeaver
DB_PORT=5433
