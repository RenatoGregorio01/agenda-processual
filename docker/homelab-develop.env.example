# Copie para docker/homelab-develop.env (não versionado) e preencha.
#
#   cp docker/homelab-develop.env.example docker/homelab-develop.env
#
# Use JWT_SECRET e TUNNEL_TOKEN diferentes dos de produção.

# URLs públicas (túnel Cloudflare `agenda-develop`)
APP_PUBLIC_URL=https://develop.agendaprocessual.com.br
NEXT_PUBLIC_API_URL=https://api-develop.agendaprocessual.com.br
CORS_ORIGINS=https://develop.agendaprocessual.com.br

# Segurança (não reutilize os valores de docker/homelab.env)
JWT_SECRET=troque-por-um-segredo-longo-aleatorio-32chars+
SEED_ADMIN_PASSWORD=troque-a-senha-do-admin-de-homologacao

# Cloudflare Zero Trust → Networks → Tunnels → segundo túnel (agenda-develop)
TUNNEL_TOKEN=

# Porta do banco exposta no host para acesso direto via DBeaver (evita conflito com prod :5433)
DB_PORT=5434
