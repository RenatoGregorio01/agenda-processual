APP_NAME=Agenda Processual API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
APP_PUBLIC_URL=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://agenda:agenda@localhost:5432/agenda_processual
DATABASE_URL_SYNC=postgresql+psycopg://agenda:agenda@localhost:5432/agenda_processual

JWT_SECRET=dev-secret-change-me-please-32b+
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

SEED_ADMIN_EMAIL=veronica@escritorio.com
SEED_ADMIN_PASSWORD=agenda123
SEED_ADMIN_NAME=Verônica
SEED_ESCRITORIO_NOME=Escritório
SEED_ESCRITORIO_SLUG=escritorio

# --- SMTP ---
# Dev (Mailpit): não entrega na internet — veja http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=agenda@local.test
SMTP_FROM_NAME=Agenda Processual
SMTP_FROM_CONVITE=convite@local.test
SMTP_FROM_NAME_CONVITE=Agenda Processual — Convite
SMTP_FROM_ALERTA=alerta@local.test
SMTP_FROM_NAME_ALERTA=Agenda Processual — Alerta
SMTP_TLS=false
SMTP_SSL=false

# Produção — Resend (domínio verificado; From distintos por responsabilidade):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_xxxxxxxx
# SMTP_FROM=noreply@agendaprocessual.com.br
# SMTP_FROM_NAME=Agenda Processual
# SMTP_FROM_CONVITE=convite@agendaprocessual.com.br
# SMTP_FROM_NAME_CONVITE=Agenda Processual — Convite
# SMTP_FROM_ALERTA=alerta@agendaprocessual.com.br
# SMTP_FROM_NAME_ALERTA=Agenda Processual — Alerta
# SMTP_TLS=true
# SMTP_SSL=false

# Produção — Gmail (senha de app; From = mesma conta, sem aliases customizados):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_FROM=seu@gmail.com
# SMTP_FROM_NAME=Agenda Processual
# SMTP_FROM_CONVITE=seu@gmail.com
# SMTP_FROM_ALERTA=seu@gmail.com
# SMTP_TLS=true
# SMTP_SSL=false

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SEED_EXAMPLE_DATA=true
METRICS_ENABLED=true

ALERTAS_ENABLED=true
ALERTAS_CRON_HOUR=8

AUDIT_PURGE_ENABLED=true
AUDIT_RETENTION_DAYS=365
AUDIT_PURGE_CRON_HOUR=3

INVITE_EXPIRE_HOURS=72

REDIS_URL=redis://localhost:6379/0

# Chave pública da wiki Datajud (pode mudar). Deixe vazio para desligar a consulta.
DATAJUD_API_KEY=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==

# DJEN / Comunica (consulta pública; IP brasileiro). Desligue com DJEN_ENABLED=false.
DJEN_ENABLED=true
DJEN_BASE_URL=https://comunicaapi.pje.jus.br/api/v1
DJEN_CRON_HOUR=7
DJEN_PRAZO_DIAS_UTEIS=15
