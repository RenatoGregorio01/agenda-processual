APP_NAME=Agenda Processual API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
APP_PUBLIC_URL=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://agenda:agenda@localhost:5432/agenda_processual
DATABASE_URL_SYNC=postgresql+psycopg://agenda:agenda@localhost:5432/agenda_processual

JWT_SECRET=dev-secret-change-me-please-32b+
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

SEED_ADMIN_EMAIL=veronica@escritorio.com
SEED_ADMIN_PASSWORD=agenda123
SEED_ADMIN_NAME=Verônica
SEED_ESCRITORIO_NOME=Escritório
SEED_ESCRITORIO_SLUG=escritorio

# --- SMTP ---
# Dev (Mailpit): não entrega na internet — veja http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=agenda@local.test
SMTP_FROM_NAME=Agenda Processual
SMTP_TLS=false
SMTP_SSL=false

# Produção — Gmail (senha de app, não a senha da conta):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_FROM=seu@gmail.com
# SMTP_FROM_NAME=Agenda Processual
# SMTP_TLS=true
# SMTP_SSL=false

# Produção — Resend:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_xxxxxxxx
# SMTP_FROM=Agenda <onboarding@resend.dev>
# SMTP_TLS=true
# SMTP_SSL=false

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SEED_EXAMPLE_DATA=true
METRICS_ENABLED=true

ALERTAS_ENABLED=true
ALERTAS_CRON_HOUR=8

INVITE_EXPIRE_HOURS=72

REDIS_URL=redis://localhost:6379/0

